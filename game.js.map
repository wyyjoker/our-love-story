        {
          "id": "park",
          "label": "游乐园",
          "clue": "页码 2 · 接在红墙照片后面的游乐园彩灯。"
        },
        {
          "id": "hotspring",
          "label": "温泉",
          "clue": "页码 3 · 温泉照片排在这一页的下方。"
        },
        {
          "id": "back_wenzhou",
          "label": "回温州",
          "clue": "页码 4 · 车票和回温州的照片收在页尾。"
