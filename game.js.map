  {
    "id": "love_letters",
    "memoryId": "first_trip",
    "title": "情书 · 把心意排成一句话",
    "unlockLevel": 3,
    "intro": "相识一百天，心意写成了一百封情书。循着信里的线索，整理那句只想对你说的话。",
    "steps": [
      {
        "title": "为信件挑一朵花",
        "requirements": [
          {
            "itemId": "flower_02",
            "count": 1
          }
        ],
        "note": "花准备好了。再添一杯咖啡，一起翻开信件。"
      },
      {
        "title": "坐下来慢慢读信",
        "requirements": [
          {
            "itemId": "coffee_04",
            "count": 1
          }
        ],
        "note": "四封信已经放在桌上。根据信封便签，把它们排成一句告白。"
      }
    ],
    "instruction": "依次点击四封信，排出完整告白；点已选择的信可撤回它及后面的信。",
    "hints": [
      "读一读四张信封上的便签，它们会告诉你前后位置。",
      "“我”开头，“你”结尾；“喜欢”紧跟着“想告诉你：”。",
      "顺序是：我 → 想告诉你： → 喜欢 → 你。"
    ],
    "puzzle": {
      "kind": "sequence",
      "tiles": [
        {
          "id": "you",
          "label": "你",
          "clue": "我在最后，等你把话说完。"
        },
        {
          "id": "like",
          "label": "喜欢",
          "clue": "我紧跟着“想告诉你：”。"
        },
        {
          "id": "me",
          "label": "我",
          "clue": "让我先开口吧。"
        },
        {
          "id": "tell",
          "label": "想告诉你：",
          "clue": "我在“我”的后面。"
        }
      ],
      "solution": [
        "me",
        "tell",
        "like",
        "you"
      ]
    },
    "replayVariants": [
      {
        "id": "practice_phrase",
        "instruction": "根据每张练习卡标注的位置，把四个词排成一句中性的心意话。",
        "hints": [
          "每张练习卡都独立写明自己应放的位置。",
          "先放第1格“愿”，再放第2格“每天”。",
          "最后按位置放“都有”和“小小欢喜”，组成“愿每天都有小小欢喜”。"
        ],
        "puzzle": {
          "kind": "sequence",
          "tiles": [
            {
              "id": "practice_joy",
              "label": "小小欢喜",
              "clue": "我是整句话的收尾，留下轻松的心情。"
            },
            {
              "id": "practice_wish",
              "label": "愿",
              "clue": "我是这句话的开头，先说出心愿。"
            },
            {
              "id": "practice_daily",
              "label": "每天",
              "clue": "我紧跟着“愿”，说明这份心意会发生在每天。"
            },
            {
              "id": "practice_have",
              "label": "都有",
              "clue": "我接在“每天”后面，连接时间和结果。"
            }
          ],
          "solution": [
            "practice_wish",
            "practice_daily",
            "practice_have",
            "practice_joy"
          ]
        }
      }
    ],
    "reward": {
      "coins": 180,
