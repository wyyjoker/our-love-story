{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "types": []
  },
  "include": [
    "assets/scripts/core/**/*",
    "assets/scripts/gameplay/**/*",
    "assets/scripts/infrastructure/**/*",
    "assets/scripts/events/**/*",
    "assets/scripts/config/**/*",
    "assets/scripts/presentation/**/*",
    "assets/scripts/ui/GameController.ts",
    "assets/scripts/ui/Theme.ts",
    "src/web/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "library",
    "temp",
    "local",
    "build",
    "native",
    "assets/scripts/platform/cocos/**/*",
    "assets/scripts/ui/cocos/**/*",
    "assets/scripts/ui/GameBootstrap.ts"
  ]
}
