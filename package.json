{
  "name": "our-love-story",
  "version": "1.3.0",
  "private": true,
  "description": "《我们的浪漫小屋》— 合成图鉴、宝箱签到、六场景家园与42段回忆",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.core.json",
    "lint:core": "tsc -p tsconfig.core.json",
    "build:web": "esbuild src/web/main.ts --bundle --outfile=game.js --format=iife --target=es2020 --sourcemap",
    "build:web:watch": "esbuild src/web/main.ts --bundle --outfile=game.js --format=iife --target=es2020 --sourcemap --watch",
    "verify:cocos": "node tools/verify-cocos-project.mjs",
    "verify:wechat-package": "node tools/check-wechat-package.mjs",
    "build:wechat": "node tools/build-wechat.mjs",
    "build:cocos-web": "node tools/build-cocos-web.mjs",
    "qa:cocos-web": "node tools/qa-cocos-web.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "verify": "node tools/verify-all.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sharp": "^0.34.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "creator": {
    "version": "3.8.8"
